# Server
HOST=127.0.0.1
PORT=4310
WEB_ORIGIN=http://127.0.0.1:3590
DATABASE_PATH=./data/agent-harness.db
RUNTIME_DATA_DIR=./data/runtimes
SESSION_TTL_HOURS=168

# Absolute directories a task may run in, comma-separated. Every task start
# re-checks the resolved workspace against this list, so a path outside it is
# refused even when a saved project still points there.
#
# Do NOT point this at this repository. In development `buildApp` grants every
# entry and registers it as a saved project, which makes the control plane a
# valid target for the agent it is supervising: a task asked to build a UI once
# overwrote apps/web/src/App.tsx and took the web app down. Use a scratch
# directory, and add real project roots deliberately.
ALLOWED_WORKSPACE_ROOTS=/absolute/path/to/a/scratch/workspace

# Durable, server-owned store for user file uploads. It MUST NOT contain, and
# MUST NOT be contained by, any ALLOWED_WORKSPACE_ROOTS entry — the server
# refuses to start otherwise. Keeping it outside every workspace root is what
# keeps uploads out of git working trees and out of the `uncommittedChanges`
# review scope. Defaults to ~/.agent-harness/uploads.
UPLOAD_DATA_DIR=

# Generate independent 32-byte values for production.
SESSION_SECRET=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters

# One-time bootstrap. The seed command hashes the password before storage.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production

# Codex app-server binary. Defaults to `codex` on PATH.
CODEX_BINARY=codex

# Experimental Codex app-server APIs are disabled unless explicitly enabled.
CODEX_EXPERIMENTAL_API=false

# Optional managed Repository Reviewer. Native codex app-server remains default.
# OpenAI operates the harness and stores prompts/tool results (currently US only,
# no Zero Data Retention), while Docker runs an isolated local read-only executor.
# Enable only for approved pilot tenants and repositories suitable for that boundary.
# Empty allowed-tenant IDs deny all managed admission. Use tenant UUIDs, never '*'.
AGENTS_API_ENABLED=false
AGENTS_API_ALLOWED_TENANT_IDS=
# Inject separate credentials from secret management. The executor key must have
# environment-connect permission only and belong to the same OpenAI project and
# user/service account as the application key. Never reuse the application key.
AGENTS_API_KEY=
AGENTS_API_EXECUTOR_KEY=
AGENTS_API_MODEL=gpt-6-astra
# Reviewed image already present locally. Accepts a full sha256:<64 hex> content
# ID or registry/name@sha256:<64 hex> digest, never a mutable tag or shortened ID.
# Build recipe: infra/agents-api/Dockerfile with an exact reviewed CODEX_VERSION.
AGENTS_API_EXECUTOR_IMAGE=
# Whole numbers only: 1–16 concurrent sessions, 1–1200 seconds per turn.
# These also consume tenant request/active-run quotas shared with native tasks.
AGENTS_API_MAX_CONCURRENT_SESSIONS=2
AGENTS_API_MAX_TURN_SECONDS=600
# Optional approved shared catalog skill names, comma-separated. No arbitrary paths.
AGENTS_API_SKILL_IDS=

# Optional Stripe subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
PUBLIC_APP_URL=http://127.0.0.1:3590

# Optional shared LiteLLM gateway for providers without a Responses-compatible API.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=

# Deployment-only opt-in for loopback/RFC1918/ULA provider endpoints and HTTP on
# those private endpoints. Keep false for hosted/shared deployments. Link-local,
# metadata, multicast, and unspecified targets remain blocked.
ALLOW_PRIVATE_PROVIDER_ENDPOINTS=false

# Reviewed shared catalog; defaults to this repository's shared/ directory.
# Contains skill-catalog.json and skills/<publisher-name>/ complete bundles.
# Only deployment operators configure this path; projects use their own .agents/skills/.
# SHARED_SKILLS_DIR=/absolute/path/to/onto-work/shared
