# Copy this file to .env. The real .env is ignored by Git.
# Generate independent high-entropy values; LiteLLM master keys must start with sk-.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_PORT=4000

# Enable at least one route by adding its credential. Model identifiers are
# configuration, not secrets, and can be changed without renaming the public alias.
OPENAI_MODEL=openai/gpt-5.5
OPENAI_API_KEY=

ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=

GEMINI_MODEL=gemini/gemini-2.5-pro
GEMINI_API_KEY=

OPENROUTER_MODEL=openrouter/openai/gpt-5
OPENROUTER_API_KEY=

# NewAPI and other OpenAI-compatible routers need an explicit upstream model and base URL.
NEWAPI_MODEL=openai/replace-with-upstream-model
NEWAPI_API_BASE=http://host.docker.internal:3000/v1
NEWAPI_API_KEY=

DEEPSEEK_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=

# These defaults are deliberately non-routable. Set the provider/model prefix and
# documented OpenAI-compatible endpoint for the service you actually operate.
DOUBAO_MODEL=openai/replace-with-doubao-model
DOUBAO_API_BASE=https://replace.invalid/v1
DOUBAO_API_KEY=

QWEN_MODEL=openai/replace-with-qwen-model
QWEN_API_BASE=https://replace.invalid/v1
QWEN_API_KEY=

GLM_MODEL=openai/replace-with-glm-model
GLM_API_BASE=https://replace.invalid/v1
GLM_API_KEY=

# From inside Docker, localhost is the gateway container. Point this at the host
# or at an Ollama service on the same explicitly configured Docker network.
OLLAMA_MODEL=ollama/qwen3-coder
OLLAMA_API_BASE=http://host.docker.internal:11434

