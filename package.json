{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "skills:import": "python3 scripts/import-shared-skills.py",
    "skills:check": "python3 scripts/import-shared-skills.py --check",
    "skills:test": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "skills:verify-runtime": "pnpm --filter @agent-harness/server exec tsx ../../scripts/verify-shared-skills.mts",
    "dev": "pnpm --parallel --filter @agent-harness/server --filter @agent-harness/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "seed": "pnpm --filter @agent-harness/server seed",
    "reset-admin": "pnpm --filter @agent-harness/server reset-admin"
  }
}
