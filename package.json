{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @agent-harness/server --filter @agent-harness/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "seed": "pnpm --filter @agent-harness/server seed",
    "reset-admin": "pnpm --filter @agent-harness/server reset-admin"
  }
}
